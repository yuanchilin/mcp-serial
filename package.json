{
  "name": "@yuanchilin/mcp-serial",
  "version": "2.6.0",
  "description": "MCP Serial Terminal server for MoterSoc - persistent serial port communication with Web monitor",
  "private": false,
  "type": "module",
  "bin": {
    "mcp-serial": "build/index.js"
  },
  "files": [
    "build"
  ],
  "scripts": {
    "build": "tsc && node -e \"const fs=require('fs');fs.chmodSync('build/index.js',0o755);fs.mkdirSync('build/vendor',{recursive:true});for(const [s,d] of [['node_modules/@xterm/xterm/lib/xterm.js','build/vendor/xterm.js'],['node_modules/@xterm/xterm/css/xterm.css','build/vendor/xterm.css']]){if(fs.existsSync(s))fs.copyFileSync(s,d)};fs.cpSync('src/viewer.html','build/viewer.html')\"",
    "start": "node build/index.js",
    "prepare": "npm run build",
    "pretest": "npm run build",
    "test": "node --test test/*.test.js",
    "smoke": "node test/smoke-boot.mjs",
    "pretest:ui": "npm run build",
    "test:ui": "node test/ui/verify.mjs --only=A,D",
    "test:ui:all": "node test/ui/verify.mjs",
    "test:checks": "node test/ui/check-fixes.mjs && node test/ui/check-firmware.mjs",
    "test:all": "npm test && npm run smoke && npm run test:ui && npm run test:checks",
    "watch": "tsc --watch",
    "inspector": "npx @modelcontextprotocol/inspector build/index.js"
  },
  "dependencies": {
    "@modelcontextprotocol/node": "^2.0.0",
    "@modelcontextprotocol/server": "^2.0.0",
    "serialport": "^13.0.0",
    "ws": "^8.21.1",
    "zod": "^4.2.0"
  },
  "devDependencies": {
    "@types/node": "^20.11.24",
    "@types/ws": "^8.18.1",
    "@xterm/xterm": "^5.5.0",
    "playwright": "^1.63.0",
    "typescript": "^5.3.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yuanchilin/mcp-serial.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
